<Window x:Class="W1sleyEdition.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="W1SLEY Edition" Width="1360" Height="860" MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen" Icon="Assets/w1sley.ico" Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        WindowStyle="None" ResizeMode="CanResize" Background="#090A0D" Foreground="#F3F1F2">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0C0D11" BorderBrush="#202229" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/w1sley-logo-256.png" Width="21" Height="21" Stretch="Uniform" Margin="0,0,9,0" />
                    <TextBlock Text="W1SLEY" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  /  EDITION" FontSize="10" Foreground="#737780" VerticalAlignment="Center" />
                    <TextBlock x:Name="AppVersionText" Text="  v0.1.0" FontSize="10" Foreground="#FF80AB" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Küçült" />
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Büyüt" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Kapat" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}" BorderBrush="#202229" BorderThickness="0,0,1,0">
                <Grid Margin="18,26,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="8,0,8,23">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" Background="#19151A" BorderBrush="#43212C" BorderThickness="1" CornerRadius="12">
                            <Image Source="Assets/w1sley-logo-256.png" Width="38" Height="38" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="W1SLEY" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="P E R F O R M A N C E" FontSize="8" Foreground="#797D87" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Ç A L I Ş M A   A L A N I" Foreground="#61656F" FontSize="9" FontWeight="SemiBold" Margin="12,0,0,8" />

                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="DashboardNav" GroupName="MainNavigation" Tag="0" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16" Width="31" /><TextBlock Text="Ana Panel" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="1" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="16" Width="31" /><TextBlock Text="RAM ve İşlemler" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="2" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="16" Width="31" /><TextBlock Text="Mini Benchmark" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="3" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" Width="31" /><TextBlock Text="Başlangıç" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="4" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="16" Width="31" /><TextBlock Text="Oyun Profilleri" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="5" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72E;" FontSize="16" Width="31" /><TextBlock Text="Güvenlik ve Sağlık" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="6" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="16" Width="31" /><TextBlock Text="Uygulama Temizleyici" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="7" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE81C;" FontSize="16" Width="31" /><TextBlock Text="Log ve Geri Al" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="8" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE839;" FontSize="16" Width="31" /><TextBlock Text="Ağ &amp; DPI Paneli" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="9" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE765;" FontSize="16" Width="31" /><TextBlock Text="Kısayol Ayarları" /></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MainNavigation" Tag="10" Style="{StaticResource SidebarNavButton}" Checked="NavigationButton_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="16" Width="31" /><TextBlock Text="Çökme Dedektörü" /></StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="3" Background="#111319" BorderBrush="#252831" BorderThickness="1" CornerRadius="10" Padding="13,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#17251F">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Güvenli yapılandırma" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Güç değişiklikleri doğrulanır" FontSize="10" Foreground="#747883" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,24,30,14">
                <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="PageTitleText" Text="Ana Panel" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitleText" Text="Sistem performansını anlık izle ve güvenle yönet." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#12151A" BorderBrush="#292D35" BorderThickness="1" CornerRadius="18" Padding="13,8" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,9,0" />
                            <TextBlock x:Name="HeaderModeText" Text="Mod okunuyor…" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

        <TabControl Grid.Row="1" x:Name="MainTabs" Style="{StaticResource ContentOnlyTabControl}">
            <!-- Tab 0: Ana Panel -->
            <TabItem Header="Ana Panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,8">
                        <Grid MinHeight="178">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid><TextBlock Text="CPU KULLANIMI" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" /><TextBlock Text="CANLI" HorizontalAlignment="Right" Foreground="#48D19A" FontSize="10" FontWeight="Bold" /></Grid>
                                    <TextBlock Grid.Row="1" x:Name="CpuUsageText" Text="--%" FontSize="32" FontWeight="Bold" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" x:Name="CpuMhzText" Text="Canlı -- GHz • -- MHz" Foreground="{StaticResource AccentBrightBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <TextBlock Grid.Row="3" x:Name="CpuModeTargetText" Text="Mod hedefi okunuyor…" Foreground="#D7D9DF" FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" Text="Windows performans telemetrisi • yükle değişir" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <ProgressBar Grid.Row="5" x:Name="CpuProgress" Maximum="100" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="BELLEK" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" x:Name="RamUsageText" Text="--%" FontSize="32" FontWeight="Bold" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" x:Name="RamDetailText" Text="-- / -- GB kullanılıyor" Foreground="{StaticResource AccentBrightBrush}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock Grid.Row="3" x:Name="RamAvailableText" Text="-- GB kullanılabilir" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                                    <ProgressBar Grid.Row="4" x:Name="RamProgress" Maximum="100" Margin="0,12,0,0" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,4,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="EKRAN KARTI" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" x:Name="GpuUsageText" Text="--%" FontSize="32" FontWeight="Bold" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2" x:Name="GpuNameText" Text="Algılanıyor…" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentBrightBrush}" FontSize="11" />
                                    <TextBlock Grid.Row="3" x:Name="GpuClockText" Text="Çekirdek -- MHz" Foreground="#D7D9DF" FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="4" x:Name="GpuVramText" Text="VRAM -- / -- GB" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                    <ProgressBar Grid.Row="5" x:Name="GpuProgress" Maximum="100" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="SICAKLIKLAR" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="CpuTempText" Text="-- °C" FontSize="25" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock x:Name="GpuTempText" Text="-- °C" FontSize="25" FontWeight="Bold" Margin="0,2,0,0" /></StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="2" x:Name="CpuTempSourceText" Text="CPU sensörü aranıyor…" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0">
                                        <TextBlock x:Name="GpuPowerText" Text="GPU -- W" Foreground="{StaticResource AccentBrightBrush}" FontSize="11" />
                                        <TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="GpuMemoryClockText" Text="Bellek -- MHz" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="GÜÇ MODU" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Fişe takılı kullanımda işlemci boost davranışını tek tıkla değiştir. Pil ayarları korunur." FontSize="17" Margin="0,5,0,15" />
                                <UniformGrid Columns="3">
                                    <Button x:Name="AggressiveModeButton" Click="AggressiveModeButton_Click" Style="{StaticResource ModeButton}" Margin="0,0,8,0" ToolTip="En hızlı boost tepkisi; daha yüksek güç ve sıcaklık.">
                                        <StackPanel>
                                            <TextBlock Text="AGRESİF PERFORMANS" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Aggressive • En hızlı tepki" FontSize="12" Opacity="0.78" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FullModeButton" Click="FullModeButton_Click" Style="{StaticResource ModeButton}" Margin="4,0" ToolTip="Oyun için güçlü ve dengeli boost davranışı.">
                                        <StackPanel>
                                            <TextBlock Text="TAM PERFORMANS" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Enabled • Dinamik tam boost" FontSize="12" Opacity="0.78" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StableModeButton" Click="StableModeButton_Click" Style="{StaticResource ModeButton}" Margin="8,0,0,0" ToolTip="Önerilen varsayılan; verimlilik ve kararlılık odaklı.">
                                        <StackPanel>
                                            <TextBlock Text="KARARLI PERFORMANS" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Efficient Enabled • Önerilen" FontSize="12" Opacity="0.78" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,13,0,0">
                                    <Border Background="#27171C" BorderBrush="#6F293B" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,8,0"><TextBlock Text="En hızlı frekans tepkisi. Daha fazla güç, sıcaklık ve fan sesi üretir; her sistemle uyumlu olmayabilir." Foreground="#FFB9C8" TextWrapping="Wrap" FontSize="11" /></Border>
                                    <Border Background="#181B22" BorderBrush="#353944" BorderThickness="1" CornerRadius="9" Padding="11" Margin="4,0"><TextBlock Text="Boost açık kalır; Windows frekansı yüke göre yönetir. Oyun ve ağır işler için dengeli yüksek performans." Foreground="#D5D8E0" TextWrapping="Wrap" FontSize="11" /></Border>
                                    <Border Background="#14211C" BorderBrush="#285743" BorderThickness="1" CornerRadius="9" Padding="11" Margin="8,0,0,0"><TextBlock Text="Verimlilik odaklı boost. Daha serin ve sakin çalışma için önerilen varsayılan mod." Foreground="#AEE8CC" TextWrapping="Wrap" FontSize="11" /></Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Background="#26111A" BorderBrush="#8E2440">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="TEK TIKLA OYUN MODU (BOOST)" FontSize="18" FontWeight="Bold" Foreground="#FF80AB" />
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Önerilen arka plan uygulamalarını kapatır, RAM'i zorla boşaltır ve Tam Performans uygular. Başlatmadan önce risk onayı ister." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,5" TextWrapping="Wrap" FontSize="11" />
                                        <TextBlock x:Name="OptimizeSummaryText" Text="Önce RAM sekmesinden kapatılacak uygulamaları seçebilirsin." Foreground="{StaticResource AccentBrightBrush}" FontSize="11" Margin="0,0,0,10" />
                                    </StackPanel>
                                    <Button x:Name="QuickOptimizeButton" Grid.Row="2" Click="OneClickGameBoost_Click" Padding="20,12" FontSize="15" Content="🚀 OYUN MODUNU BAŞLAT" HorizontalAlignment="Left" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Background="#141C24" BorderBrush="#254B52">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="RAM BAKIMI" FontSize="18" FontWeight="Bold" Foreground="#4DD0E1" />
                                    <TextBlock Grid.Row="1" Text="Güvenli bakım yalnızca W1SLEY belleğini düzenler. Zorla temizleme bütün çalışma kümelerini ve standby önbelleğini boşaltır." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,15" TextWrapping="Wrap" FontSize="11" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Click="CleanRamButton_Click" Padding="16,12" FontSize="13" Content="GÜVENLİ BAKIM" Style="{StaticResource SecondaryButton}" />
                                        <Button Click="ForceCleanRamButton_Click" Padding="16,12" Margin="8,0,0,0" FontSize="13" Content="ZORLA BOŞALT" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 1: RAM ve İşlemler -->
            <TabItem Header="RAM ve İşlemler">
                <Grid Margin="0,18,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="14" Background="#201720" BorderBrush="#49303C" BorderThickness="1" VerticalAlignment="Top">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="#D78BA0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AKILLI SÜREÇ YÖNETİMİ" Style="{StaticResource KickerText}" />
                                <TextBlock Text="RAM Hafifletme" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="Görünür uygulamalar, oyunlar, anti-cheat ve kritik Windows işlemleri otomatik korunur." Foreground="{StaticResource MutedBrush}" Margin="0,3,20,0" />
                                <TextBlock x:Name="ProcessSelectionText" Text="Önerilen arka plan işlemleri otomatik seçildi." Foreground="#B97C8B" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource CompactButton}" Content="Tümünü Seç" Click="SelectAllProcessesButton_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource CompactButton}" Content="Seçimi Temizle" Click="ClearProcessSelectionButton_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Yenile" Click="RefreshProcessesButton_Click" Margin="0,0,8,0" />
                                <Button Content="Hızlandır" Click="OptimizeButton_Click" Padding="18,10" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,6,0"><Grid><StackPanel><TextBlock Text="ÇALIŞAN SÜREÇ" Style="{StaticResource KickerText}" /><TextBlock x:Name="ProcessTotalText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="AKILLI ÖNERİ" Style="{StaticResource KickerText}" /><TextBlock x:Name="ProcessRecommendedText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrightBrush}" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE8FB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#814257" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="SEÇİLİ BELLEK" Style="{StaticResource KickerText}" /><TextBlock x:Name="ProcessSelectedMemoryText" Text="— MB" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0,0,0"><Grid><StackPanel><TextBlock Text="KORUMA ALTINDA" Style="{StaticResource KickerText}" /><TextBlock x:Name="ProcessProtectedText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#39785D" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="2" x:Name="ProcessesGrid" IsReadOnly="False" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="52">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"><CheckBox.Style><Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding IsProtected}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="UYGULAMA / İŞLEM" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="7" Background="#1F222A"><TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#969BA6" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="#707581" FontSize="10" Margin="0,2,0,0" /></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RAM KULLANIMI" Width="125" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding MemoryMb, Mode=OneWay, StringFormat={}{0:N0} MB}" FontWeight="SemiBold" /><Border Height="3" Width="72" Background="#292D36" CornerRadius="2" HorizontalAlignment="Left" Margin="0,5,0,0"><Border Width="28" Background="#8F2440" CornerRadius="2" HorizontalAlignment="Left" /></Border></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="W1SLEY ANALİZİ" Width="285" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><TextBlock x:Name="AnalysisText" Text="{Binding RecommendationReason, Mode=OneWay}" Foreground="#AEB2BC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock x:Name="NoAnalysisText" Text="Kullanıcı süreci" Foreground="#626772" VerticalAlignment="Center" Visibility="Collapsed" /></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding RecommendationReason}" Value=""><Setter TargetName="AnalysisText" Property="Visibility" Value="Collapsed" /><Setter TargetName="NoAnalysisText" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DURUM" Width="115" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="StatusBadge" Background="#17251F" BorderBrush="#285440" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="StatusLabel" Text="Hazır" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsProtected}" Value="True"><Setter TargetName="StatusBadge" Property="Background" Value="#1D2027" /><Setter TargetName="StatusBadge" Property="BorderBrush" Value="#373B46" /><Setter TargetName="StatusLabel" Property="Text" Value="Korumalı" /><Setter TargetName="StatusLabel" Property="Foreground" Value="#A5A9B3" /></DataTrigger><DataTrigger Binding="{Binding IsRecommended}" Value="True"><Setter TargetName="StatusBadge" Property="Background" Value="#2B1720" /><Setter TargetName="StatusBadge" Property="BorderBrush" Value="#693045" /><Setter TargetName="StatusLabel" Property="Text" Value="Önerilen" /><Setter TargetName="StatusLabel" Property="Foreground" Value="#E588A0" /></DataTrigger></DataTemplate.Triggers></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Mini Benchmark -->
            <TabItem Header="Mini Benchmark">
                <Grid Margin="0,18,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PERFORMANS ÖLÇÜMÜ" Style="{StaticResource KickerText}" />
                                    <TextBlock Text="İşlemci Benchmark" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="Güç modunu değiştirmeden kontrollü işlem yükü uygular. Uzun test daha düşük iş parçacığı sayısıyla çalışır." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,7,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock Text="HIZLI ÖLÇÜM" Style="{StaticResource KickerText}" />
                                            <TextBlock Grid.Row="1" Text="15 saniye" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,3" />
                                            <Button Grid.Row="2" x:Name="BenchmarkButton" Content="Kısa Testi Başlat" Click="BenchmarkButton_Click" Margin="0,13,0,0" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource InsetCardStyle}" Margin="7,0,0,0" BorderBrush="#55303B">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock Text="UZUN ÖLÇÜM" Style="{StaticResource KickerText}" Foreground="#D8899B" />
                                            <TextBlock Grid.Row="1" Text="60 saniye" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,3" />
                                            <Button Grid.Row="2" x:Name="LongBenchmarkButton" Content="Uzun Testi Başlat" Style="{StaticResource SecondaryButton}" Click="LongBenchmarkButton_Click" Margin="0,13,0,0" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="2" Background="#0D0F13" BorderBrush="#252832" BorderThickness="1" CornerRadius="11" Padding="18">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BenchmarkModeText" Text="TEST BEKLİYOR" Style="{StaticResource KickerText}" />
                                            <TextBlock Grid.Column="1" Text="CPU" Foreground="#626773" FontSize="10" />
                                        </Grid>
                                        <TextBlock x:Name="BenchmarkScoreText" Text="—" FontSize="38" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" Margin="0,12,0,4" />
                                        <TextBlock x:Name="BenchmarkResultText" Text="Henüz ölçüm yapılmadı." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="BenchmarkProgress" Maximum="100" Height="8" Margin="0,18,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Row="3" x:Name="CancelBenchmarkButton" Content="Testi Durdur" Style="{StaticResource SecondaryButton}" Click="CancelBenchmarkButton_Click" Margin="0,14,0,0" IsEnabled="False" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <Border Width="54" Height="54" Background="#25161D" BorderBrush="#51303A" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Test profili" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,12" />
                                <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,0,10"><Grid><TextBlock Text="Güç modu korunur" /><TextBlock Text="DEĞİŞMEZ" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid></Border>
                                <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,0,10"><Grid><TextBlock Text="Kısa test yükü" /><TextBlock Text="%50 iş parçacığı" Foreground="#B7BAC3" HorizontalAlignment="Right" /></Grid></Border>
                                <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,0,10"><Grid><TextBlock Text="Uzun test yükü" /><TextBlock Text="%33 iş parçacığı" Foreground="#B7BAC3" HorizontalAlignment="Right" /></Grid></Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Başlangıç -->
            <TabItem Header="Başlangıç">
                <Grid Margin="0,18,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="14" Background="#17241F" BorderBrush="#2B513F" BorderThickness="1" VerticalAlignment="Top">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="OTURUM AÇILIŞ KONTROLÜ" Style="{StaticResource KickerText}" />
                                <TextBlock Text="Başlangıç Yöneticisi" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="Kullanıcı girdileri yedeklenerek yönetilir; Windows ve donanım girdileri korunur." Foreground="{StaticResource MutedBrush}" Margin="0,3,20,0" />
                                <TextBlock x:Name="StartupSelectionText" Text="Bir öğe seçerek başlangıç durumunu değiştirebilirsin." Foreground="#7F8490" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="Yenile" Click="RefreshStartupButton_Click" Margin="0,0,8,0" />
                                <Button Content="Seçili Öğeyi Aç / Kapat" Click="ToggleStartupButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,6,0"><Grid><StackPanel><TextBlock Text="TOPLAM GİRDİ" Style="{StaticResource KickerText}" /><TextBlock x:Name="StartupTotalText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="ETKİN" Style="{StaticResource KickerText}" /><TextBlock x:Name="StartupEnabledText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#39785D" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="DEVRE DIŞI" Style="{StaticResource KickerText}" /><TextBlock x:Name="StartupDisabledText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#D68A9C" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#814257" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0,0,0"><Grid><StackPanel><TextBlock Text="YÖNETİLEBİLİR" Style="{StaticResource KickerText}" /><TextBlock x:Name="StartupManageableText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="2" x:Name="StartupGrid" IsReadOnly="True" RowHeight="50" SelectionChanged="StartupGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="DURUM" Width="105" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="StartupBadge" Background="#17251F" BorderBrush="#285440" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StartupDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" /><TextBlock x:Name="StartupState" Text="Etkin" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" /></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter TargetName="StartupBadge" Property="Background" Value="#26181E" /><Setter TargetName="StartupBadge" Property="BorderBrush" Value="#56303D" /><Setter TargetName="StartupDot" Property="Fill" Value="#C96A82" /><Setter TargetName="StartupState" Property="Text" Value="Kapalı" /><Setter TargetName="StartupState" Property="Foreground" Value="#D98A9E" /></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="UYGULAMA" Width="230" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="7" Background="#20232B"><TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#999DA7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Location, Mode=OneWay}" Foreground="#727783" FontSize="10" Margin="0,2,0,0" /></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="BAŞLATMA KOMUTU" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Command, Mode=OneWay}" Foreground="#B5B8C1" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ERİŞİM" Width="125" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="AccessBadge" Background="#1F2229" BorderBrush="#393D47" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="AccessText" Text="Sistem korumalı" Foreground="#9CA0AA" FontSize="10" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding CanToggle}" Value="True"><Setter TargetName="AccessBadge" Property="Background" Value="#211721" /><Setter TargetName="AccessBadge" Property="BorderBrush" Value="#553044" /><Setter TargetName="AccessText" Property="Text" Value="Yönetilebilir" /><Setter TargetName="AccessText" Property="Foreground" Value="#D98A9E" /></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 4: Oyun Profilleri -->
            <TabItem Header="Oyun Profilleri">
                <Grid Margin="0,18,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="190" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OTOMATİK OYUN KÜTÜPHANESİ" Style="{StaticResource KickerText}" />
                                    <TextBlock Text="Bulunan Oyunlar" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <TextBlock x:Name="GameScanStatusText" Text="Steam, Epic ve oyun klasörleri taranıyor…" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Tümünü Seç" Style="{StaticResource CompactButton}" Click="SelectAllGamesButton_Click" Margin="0,0,7,0" />
                                    <Button x:Name="ScanGamesButton" Content="Yeniden Tara" Style="{StaticResource CompactButton}" Click="ScanGamesButton_Click" />
                                </StackPanel>
                            </Grid>
                            <ListBox Grid.Row="1" x:Name="DiscoveredGamesList" Margin="0,13,0,14" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCardStyle}" Padding="12" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" Background="#1C1E25" BorderBrush="#343843" BorderThickness="1" CornerRadius="9">
                                                    <Image Source="{Binding IconSource, Mode=OneWay}" Width="30" Height="30" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,12,0">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Source, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="AKTİF PROFİLLER" Style="{StaticResource KickerText}" />
                                    <TextBlock Text="Otomatik algıla veya W1SLEY içinden başlat" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Seçilenleri Profil Yap" Click="AddSelectedGamesButton_Click" />
                            </Grid>
                            <DataGrid Grid.Row="3" x:Name="ProfilesGrid" IsReadOnly="False" SelectionChanged="ProfilesGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="48" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding IconSource, Mode=OneWay}" Width="25" Height="25" Stretch="Uniform" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="Açık" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                    <DataGridTextColumn Header="Profil" Binding="{Binding Name, Mode=OneWay}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Mod" Binding="{Binding ModeLabel, Mode=OneWay}" Width="145" IsReadOnly="True" />
                                    <DataGridTextColumn Header="DNS" Binding="{Binding DnsLabel, Mode=OneWay}" Width="90" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="ProfileMonitoringCheckBox" Content="Profil izleme aktif" IsChecked="True" Margin="0,0,16,0" />
                                <Button Content="Tepsiye Küçült" Style="{StaticResource SecondaryButton}" Click="MinimizeToTrayButton_Click" />
                                <Button Content="Seçili Oyunu Başlat" Click="LaunchProfileButton_Click" Margin="8,0,0,0" />
                                <Button Content="Profili Sil" Style="{StaticResource SecondaryButton}" Click="DeleteProfileButton_Click" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" Background="#191B22" BorderBrush="#343843" BorderThickness="1" CornerRadius="11">
                                    <Image x:Name="ProfileIconImage" Source="Assets/w1sley-logo-256.png" Width="34" Height="34" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PROFİL STÜDYOSU" Style="{StaticResource KickerText}" />
                                    <TextBlock Text="Oyun davranışını düzenle" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Profil adı" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="ProfileNameBox" Margin="0,3,0,10" />
                            <TextBlock Text="Oyun .exe dosyası" Foreground="{StaticResource MutedBrush}" />
                            <DockPanel Margin="0,3,0,10">
                                <Button DockPanel.Dock="Right" Content="Seç" Click="BrowseGameButton_Click" Padding="13,7" Margin="7,0,0,0" />
                                <TextBox x:Name="ProfilePathBox" />
                            </DockPanel>
                            <TextBlock Text="Güç modu" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="ProfileModeCombo" Margin="0,3,0,10" DisplayMemberPath="Label" SelectedValuePath="Value" />
                            <TextBlock Text="Oyun DNS profili" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="ProfileDnsCombo" Margin="0,3,0,10" DisplayMemberPath="Label" SelectedValuePath="Value" />
                            <TextBlock Text="Oyun sırasında kapatılacaklar" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="ProfileBackgroundBox" Margin="0,3,0,8" TextWrapping="Wrap" Height="58" />
                            <CheckBox x:Name="ProfileRestoreCheckBox" Content="Oyun kapanınca uygulamaları yeniden aç" IsChecked="True" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Yeni Profil" Style="{StaticResource SecondaryButton}" Click="NewProfileButton_Click" Margin="0,0,8,0" />
                                <Button Content="Kaydet" Click="SaveProfileButton_Click" />
                                <Button Content="Profili Başlat" Click="LaunchProfileButton_Click" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ProfileStatusText" Foreground="{StaticResource AccentBrightBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 5: Güvenlik ve Sağlık -->
            <TabItem Header="Güvenlik ve Sağlık">
                <Grid Margin="0,18,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="16" Background="#17251F" BorderBrush="#285440" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="27" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="W1SLEY GÜVENLİK MERKEZİ" Style="{StaticResource KickerText}" />
                                    <TextBlock Text="Tehdit Taraması" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="Windows güvenlik motorunu kullanarak dosyaları denetler." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="QuickSecurityScanButton" Content="Hızlı Tarama" Click="QuickSecurityScanButton_Click" />
                                        <Button x:Name="FullSecurityScanButton" Content="Tam Tarama" Style="{StaticResource SecondaryButton}" Click="FullSecurityScanButton_Click" Margin="9,0,0,0" />
                                        <Button x:Name="CancelSecurityScanButton" Content="Durdur" Style="{StaticResource SecondaryButton}" Click="CancelSecurityScanButton_Click" Margin="9,0,0,0" IsEnabled="False" />
                                    </StackPanel>
                                    <ProgressBar x:Name="DefenderProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,16,0,0" />
                                    <TextBlock x:Name="DefenderResultText" Text="Tarama bekliyor." TextWrapping="Wrap" Foreground="#AEB2BC" Margin="0,11,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,12">
                            <StackPanel>
                                <Border Width="46" Height="46" CornerRadius="13" Background="#211820" BorderBrush="#49303A" BorderThickness="1" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" Foreground="#D98DA0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="SİSTEM SAĞLIĞI" Style="{StaticResource KickerText}" Margin="0,14,0,0" />
                                <TextBlock Text="Donanım ve Windows kontrolü" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="Aygıt, disk ve son 24 saatin kritik donanım olaylarını inceler." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <Button x:Name="HealthButton" Content="Sağlık Kontrolü" Click="HealthButton_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="HealthGrid" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="110" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="145" />
                            <DataGridTextColumn Header="Ayrıntı" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 6: Uygulama Temizleyici -->
            <TabItem Header="Uygulama Temizleyici">
                <Grid Margin="0,18,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="14" Background="#24171D" BorderBrush="#58303F" BorderThickness="1" VerticalAlignment="Top">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="#DC8A9F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="GÜVENLİ UYGULAMA KASASI" Style="{StaticResource KickerText}" />
                                <TextBlock Text="Uygulama Temizleyici" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="Windows paketlerini analiz eder; sistem bileşenlerini otomatik korur." Foreground="{StaticResource MutedBrush}" Margin="0,3,20,0" />
                                <TextBlock x:Name="AppSelectionText" Text="Güvenle yönetilebilen uygulamalar seçilebilir." Foreground="#7F8490" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RecommendedAppsButton" Content="Önerilenleri Seç" Style="{StaticResource CompactButton}" Click="SelectRecommendedAppsButton_Click" Margin="0,0,8,0" />
                                <Button Content="Tümünü Seç" Style="{StaticResource CompactButton}" Click="SelectAllAppsButton_Click" Margin="0,0,8,0" />
                                <Button Content="Seçimi Temizle" Style="{StaticResource CompactButton}" Click="ClearAppSelectionButton_Click" Margin="0,0,8,0" />
                                <Button x:Name="ScanAppsButton" Content="Yeniden Tara" Style="{StaticResource SecondaryButton}" Click="ScanAppsButton_Click" Margin="0,0,8,0" />
                                <Button x:Name="RemoveAppsButton" Content="Güvenle Kaldır" Click="RemoveAppsButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,6,0"><Grid><StackPanel><TextBlock Text="UYGULAMA" Style="{StaticResource KickerText}" /><TextBlock x:Name="AppTotalText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="KORUMA ALTINDA" Style="{StaticResource KickerText}" /><TextBlock x:Name="AppProtectedText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#39785D" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="KALDIRILABİLİR" Style="{StaticResource KickerText}" /><TextBlock x:Name="AppRemovableText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#D68A9C" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#814257" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0,0,0"><Grid><StackPanel><TextBlock Text="SEÇİLİ" Style="{StaticResource KickerText}" /><TextBlock x:Name="AppSelectedText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Style="{StaticResource InsetCardStyle}" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="320" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#808591" FontSize="15" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="AppSearchBox" TextChanged="AppSearchBox_TextChanged" ToolTip="Ara" />
                            <TextBlock Grid.Column="2" Text="GÖRÜNÜM" Style="{StaticResource KickerText}" VerticalAlignment="Center" Margin="24,0,12,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="RemovableOnlyCheckBox" Content="Yalnız kaldırılabilir" Checked="AppFilter_Changed" Unchecked="AppFilter_Changed" Margin="0,0,20,0" />
                                <CheckBox x:Name="RecommendedOnlyCheckBox" Content="Yalnız W1SLEY önerileri" Checked="AppFilter_Changed" Unchecked="AppFilter_Changed" />
                            </StackPanel>
                            <TextBlock Grid.Column="4" x:Name="AppVisibleCountText" Text="0 sonuç" Foreground="#777C87" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="3" x:Name="AppsGrid" IsReadOnly="False" RowHeight="50">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"><CheckBox.Style><Style TargetType="CheckBox"><Setter Property="IsEnabled" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding IsProtected}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="UYGULAMA" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="8" Background="#211920" BorderBrush="#38303A" BorderThickness="1"><TextBlock Text="{Binding CategoryGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#D28398" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="10" Foreground="#727783" Margin="0,2,0,0"><Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="KATEGORİ" Width="125" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#1D2027" BorderBrush="#363A44" BorderThickness="1" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Category, Mode=OneWay}" Foreground="#A9ADB6" FontSize="10" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="W1SLEY ANALİZİ" Width="270" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProtectionReason, Mode=OneWay}" Foreground="#AEB2BC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 7: Log ve Geri Al -->
            <TabItem Header="Log ve Geri Al">
                <Grid Margin="0,18,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="14" Background="#211720" BorderBrush="#52303E" BorderThickness="1" VerticalAlignment="Top">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="#D9899E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="DEĞİŞİKLİK GEÇMİŞİ" Style="{StaticResource KickerText}" />
                                <TextBlock Text="Geri Alma Merkezi" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="W1SLEY işlemlerini zaman, sonuç ve geri alma desteğiyle takip et." Foreground="{StaticResource MutedBrush}" Margin="0,3,20,0" />
                                <TextBlock x:Name="LogSelectionText" Text="Geri alınabilir bir kayıt seçtiğinde işlem düğmesi kullanılabilir." Foreground="#7F8490" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Yenile" Style="{StaticResource CompactButton}" Click="RefreshLogsButton_Click" Margin="0,0,8,0" />
                                <Button Content="Log Klasörünü Aç" Style="{StaticResource SecondaryButton}" Click="OpenLogsButton_Click" Margin="0,0,8,0" />
                                <Button Content="Seçili İşlemi Geri Al" Click="UndoButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,6,0"><Grid><StackPanel><TextBlock Text="KAYITLI İŞLEM" Style="{StaticResource KickerText}" /><TextBlock x:Name="LogTotalText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="BAŞARILI" Style="{StaticResource KickerText}" /><TextBlock x:Name="LogSuccessText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#39785D" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="GERİ ALINABİLİR" Style="{StaticResource KickerText}" /><TextBlock x:Name="LogUndoableText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#39785D" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0,0,0"><Grid><StackPanel><TextBlock Text="KAZANILAN RAM" Style="{StaticResource KickerText}" /><TextBlock x:Name="LogFreedMemoryText" Text="— MB" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid></Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="2" x:Name="LogsGrid" IsReadOnly="True" RowHeight="50" SelectionChanged="LogsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ZAMAN" Width="165" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C1E26" BorderBrush="#2F3342" BorderThickness="1" CornerRadius="8" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeLabel, Mode=OneWay}" Foreground="#D9DCE5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="İŞLEM" Width="205" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="7" Background="#211820"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#D08095" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border><TextBlock Grid.Column="1" Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="AYRINTI" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail, Mode=OneWay}" Foreground="#B3B6BF" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 8: Ağ Paneli -->
            <TabItem Header="Ağ Ayarları">
                <Grid Margin="0,18,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="OYUN PİNG &amp; TCP GECİKME İYİLEŞTİRMESİ" FontSize="18" FontWeight="Bold" Foreground="#48D19A" />
                                <TextBlock Text="TcpAckFrequency ve TCPNoDelay ayarlarını Windows Kayıt Defterine uygular. Ağ kartının paket bekletmesini engeller." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,15" TextWrapping="Wrap" FontSize="12" />
                                <Button Click="ApplyNetworkLatency_Click" Padding="16,10" Content="⚡ PİNG &amp; TCP OPTİMİZASYONUNU UYGULA" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HIZLI GÜVENLİ DNS DEĞİŞTİRİCİ" FontSize="18" FontWeight="Bold" Foreground="#FFD54F" />
                                        <TextBlock Text="İnternet bağlantınızın DNS sunucularını değiştirin veya kapatıp varsayılana sıfırlayın." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,5" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock x:Name="ActiveDnsStatusText" Text="Aktif DNS: Okunuyor…" Foreground="#48D19A" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" />
                                    </StackPanel>
                                    <Button x:Name="DisableDnsBtn" Grid.Column="1" Click="DisableDns_Click" Content="🛑 Özel DNS'i Kapat (DHCP)" Padding="14,8" Background="#3E171D" BorderBrush="#8E2437" Foreground="#FFB9C8" FontWeight="Bold" VerticalAlignment="Top" ToolTip="Özel DNS'i kapatır ve otomatik varsayılan (DHCP) ağ ayarlarına geri döndürür." />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button x:Name="CloudflareDnsBtn" Click="CloudflareDns_Click" Content="⚡ Cloudflare (1.1.1.1)" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                    <Button x:Name="GoogleDnsBtn" Click="GoogleDns_Click" Content="🌐 Google (8.8.8.8)" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                    <Button x:Name="ResetDhcpDnsBtn" Click="ResetDhcpDns_Click" Content="🔄 Otomatik (DHCP)" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                    <Button Click="FlushDns_Click" Content="🧹 Flush DNS" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 9: Kısayol Ayarları -->
            <TabItem Header="Kısayol Ayarları">
                <Grid Margin="0,18,0,8">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="KÜRESEL KISAYOL TUŞLARI (HOTKEYS)" FontSize="18" FontWeight="Bold" Foreground="#81D4FA" />
                            <TextBlock Text="Sistem genelinde çalışan 2 tuşlu kısayol kombinasyonlarını özelleştirin." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" TextWrapping="Wrap" FontSize="12" />

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Değiştirici Tuş (Modifier):" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox Grid.Column="1" x:Name="ModifierCombo">
                                    <ComboBoxItem Content="Alt" IsSelected="True" />
                                    <ComboBoxItem Content="Ctrl" />
                                    <ComboBoxItem Content="Shift" />
                                    <ComboBoxItem Content="Win" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pencere Aç / Gizle:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="ToggleWindowKeyText" Text="W" MaxLength="1" TextAlignment="Center" FontWeight="Bold" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Güvenli RAM Bakımı:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="CleanRamKeyText" Text="R" MaxLength="1" TextAlignment="Center" FontWeight="Bold" />
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Oyun Modu Boost:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="GameBoostKeyText" Text="B" MaxLength="1" TextAlignment="Center" FontWeight="Bold" />
                            </Grid>

                            <Button Click="SaveHotkeys_Click" Padding="20,10" Content="Kısayolları Kaydet ve Uygula" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 10: Çökme Dedektörü -->
            <TabItem Header="Çökme Dedektörü">
                <Grid Margin="0,18,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="15" Background="#2B171E" BorderBrush="#6B3043" BorderThickness="1" VerticalAlignment="Top">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="#F0809E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="W1SLEY KARARLILIK MERKEZİ" Style="{StaticResource KickerText}" />
                                <TextBlock Text="Çökme Dedektörü" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="CrashStatusText" Text="Kernel-Power, BugCheck, WHEA ve ekran sürücüsü olayları okunuyor…" Foreground="{StaticResource MutedBrush}" Margin="0,4,20,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CrashRefreshButton" Content="Yeniden Tara" Click="RefreshCrashEventsButton_Click" Margin="0,0,8,0" />
                                <Button Content="Olay Görüntüleyici" Style="{StaticResource SecondaryButton}" Click="OpenEventViewerButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource InsetCardStyle}" Margin="0,0,6,0"><Grid><StackPanel><TextBlock Text="TOPLAM OLAY" Style="{StaticResource KickerText}" /><TextBlock x:Name="CrashTotalText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#626875" FontSize="18" HorizontalAlignment="Right" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="KRİTİK" Style="{StaticResource KickerText}" /><TextBlock x:Name="CrashCriticalText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#F0809E" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE814;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#884158" FontSize="18" HorizontalAlignment="Right" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0"><Grid><StackPanel><TextBlock Text="WHEA" Style="{StaticResource KickerText}" /><TextBlock x:Name="CrashWheaText" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="#F2AE5D" Margin="0,6,0,0" /></StackPanel><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#876139" FontSize="18" HorizontalAlignment="Right" /></Grid></Border>
                        <Border Style="{StaticResource InsetCardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="SON OLAY" Style="{StaticResource KickerText}" /><TextBlock x:Name="CrashLastText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="2" x:Name="CrashEventsGrid" IsReadOnly="True" RowHeight="54">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ZAMAN" Width="160" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#1C1E26" BorderBrush="#2F3342" BorderThickness="1" CornerRadius="8" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding TimeLabel, Mode=OneWay}" Foreground="#D9DCE5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SEVİYE" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="CrashSeverityBadge" Background="#30201B" BorderBrush="#725037" BorderThickness="1" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left"><TextBlock x:Name="CrashSeverityText" Text="{Binding Severity}" Foreground="#F2AE5D" FontSize="10" FontWeight="SemiBold" /></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Severity}" Value="Kritik"><Setter TargetName="CrashSeverityBadge" Property="Background" Value="#30171F" /><Setter TargetName="CrashSeverityBadge" Property="BorderBrush" Value="#783249" /><Setter TargetName="CrashSeverityText" Property="Foreground" Value="#F0809E" /></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="TÜR" Binding="{Binding Category}" Width="105" />
                            <DataGridTextColumn Header="OLAY" Binding="{Binding EventLabel}" Width="210" />
                            <DataGridTextColumn Header="GÜÇ MODU" Binding="{Binding PowerMode}" Width="190" />
                            <DataGridTemplateColumn Header="AYRINTI" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,2,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
