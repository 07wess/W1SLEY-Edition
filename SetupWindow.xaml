<Window x:Class="W1sleyEdition.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="W1SLEY Edition Kurulumu" Width="1060" Height="780"
        MinWidth="940" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="58" Height="58" CornerRadius="16" Background="#21151A" BorderBrush="#6F293B" BorderThickness="1">
                <Image Source="pack://application:,,,/Assets/w1sley-logo-256.png" Margin="8" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="W1SLEY EDITION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" />
                <TextBlock Text="İlk Kurulum ve Sistem Analizi" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="#14211C" BorderBrush="#285743" BorderThickness="1" CornerRadius="16" Padding="13,8" VerticalAlignment="Center">
                <TextBlock Text="WINDOWS 11 • x64" Foreground="#82DDB0" FontSize="11" FontWeight="Bold" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="1" Text="W1SLEY Edition sistemini değiştirmeden önce uyumluluğu salt okunur kontrol eder. Ardından kullanmak istediğin işlemci boost davranışını seçebilirsin." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,18,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SİSTEM TARAMASI" Style="{StaticResource KickerText}" />
                            <TextBlock x:Name="ScanTitleText" Text="Donanım ve Windows denetleniyor…" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ScanAgainButton" Content="Yeniden Tara" Style="{StaticResource CompactButton}" Click="ScanAgainButton_Click" IsEnabled="False" />
                    </Grid>
                    <ProgressBar Grid.Row="1" x:Name="ScanProgress" IsIndeterminate="True" Height="3" Margin="0,15,0,10" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ScanItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#101217" BorderBrush="#292C35" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Background="{Binding Accent}" CornerRadius="4" Margin="0,1,0,1" />
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding Category}" Foreground="{Binding Accent}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#1B1E25" BorderBrush="#353944" BorderThickness="1" CornerRadius="9" Padding="8,4" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding State}" Foreground="{Binding Accent}" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="9,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="BAŞLANGIÇ MODU" Style="{StaticResource KickerText}" />
                        <TextBlock Text="İşlemci davranışını seç" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="Fişe takılı kullanım içindir; pil ayarları korunur. Daha sonra ana panelden değiştirilebilir." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,14" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="AggressiveSetupButton" Click="AggressiveSetupButton_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,0,0,9">
                            <StackPanel><TextBlock Text="AGRESİF PERFORMANS" FontWeight="Bold" /><TextBlock Text="Aggressive • En hızlı tepki" Foreground="#F0A7B9" FontSize="11" Margin="0,3,0,0" /><TextBlock Text="En yüksek güç ve sıcaklık. Donanıma göre kararsızlık oluşturabilir." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                        </Button>
                        <Button x:Name="FullSetupButton" Click="FullSetupButton_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,0,0,9">
                            <StackPanel><TextBlock Text="TAM PERFORMANS" FontWeight="Bold" /><TextBlock Text="Enabled • Dinamik tam boost" Foreground="#D7A2B0" FontSize="11" Margin="0,3,0,0" /><TextBlock Text="Oyun ve ağır işlerde güçlü, Windows kontrollü performans." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                        </Button>
                        <Button x:Name="StableSetupButton" Click="StableSetupButton_Click" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Padding="14">
                            <StackPanel><TextBlock Text="KARARLI PERFORMANS" FontWeight="Bold" /><TextBlock Text="Efficient Enabled • Önerilen" Foreground="#82DDB0" FontSize="11" Margin="0,3,0,0" /><TextBlock Text="Verimlilik, sıcaklık ve performans arasında güvenli varsayılan." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#101217" BorderBrush="#292C35" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,14,0,0">
                        <TextBlock x:Name="SelectedModeDescriptionText" TextWrapping="Wrap" FontSize="10" Foreground="#C7CAD2" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <TextBlock x:Name="SetupStatusText" Text="Tarama başlatılıyor…" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Çıkış" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" Margin="0,0,9,0" />
                <Button x:Name="CompleteButton" Content="Kurulumu Tamamla" Click="CompleteButton_Click" IsEnabled="False" Padding="20,11" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
